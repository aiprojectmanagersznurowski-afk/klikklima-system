## 2. Architektura Bazy Danych i Wyszukiwania Wektorowego (SQL)

```sql
-- 1. Włączenie rozszerzenia wektorowego
create extension if not exists vector;

-- 2. Tabela bazy wiedzy z podziałem na uprawnienia
create table public.knowledge_base (
  id uuid primary key default gen_random_uuid(),
  content text not null,
  metadata jsonb default '{}'::jsonb,
  access_level text not null check (access_level in ('public', 'field_tech', 'internal_dispatcher', 'internal_admin')),
  embedding vector(768), -- Wymiarowość dla modelu text-embedding-004 od Google
  created_at timestamptz default now()
);

-- 3. Indeks HNSW do szybkiego wyszukiwania podobieństwa kosinusowego
create index on public.knowledge_base
using hnsw (embedding vector_cosine_ops);

-- 4. Funkcja wyszukiwania z uwzględnieniem poziomu dostępu
create or replace function match_knowledge_base (
  query_embedding vector(768),
  match_threshold float,
  match_count int,
  allowed_levels text[]
)
returns table (
  id uuid,
  content text,
  metadata jsonb,
  similarity float
)
language plpgsql
stable
as $$ 
begin   
  return query   
  select     
    kb.id,     
    kb.content,     
    kb.metadata,     
    1 - (kb.embedding <=> query_embedding) as similarity   
  from public.knowledge_base kb   
  where kb.access_level = any(allowed_levels)     
    and 1 - (kb.embedding <=> query_embedding) > match_threshold   
  order by kb.embedding <=> query_embedding   
  limit match_count; 
end; 
$$;
```

