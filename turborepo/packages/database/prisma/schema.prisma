generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model indoor_units {
  id                           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  model_code                   String   @unique
  series_name                  String
  brand                        String
  is_single_compatible         Boolean? @default(false)
  is_multi_compatible          Boolean? @default(false)
  cooling_capacity_kw          Decimal? @db.Decimal
  heating_capacity_kw          Decimal? @db.Decimal
  power_consumption_cooling_kw Decimal? @db.Decimal
  power_consumption_heating_kw Decimal? @db.Decimal
  dimensions                   String?
  noise_level_min_db           Int?
  has_wifi                     Boolean? @default(false)
  has_presence_sensor          Boolean? @default(false)
  is_silent_mode               Boolean? @default(false)
  price_netto                  Decimal? @db.Decimal
  image_url                    String?
  marketing_description        String?
  created_at                   DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  color                        String?  @default("Biały")
  recommended_area_m2          Int?
  features                     Json?

  modele_3d modele_3d[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model klienci {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_number   String   @unique @default(dbgenerated("('K-'::text || lpad((nextval('clients_client_number_seq'::regclass))::text, 6, '0'::text))"))
  imie_i_nazwisko String?
  email           String?
  telefon         String?
  created_at      DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  /// CRM-CLIENT-ANONYMIZE-RODO (WO CLIENT-ANONYMIZATION-RODO, Faza A).
  /// NULL = rekord nietknięty; znacznik = moment anonimizacji (UTC).
  /// Kolumna istnieje po to, żeby idempotencję dało się sprawdzić ograniczeniem, a nie porównaniem
  /// treści: „imie_i_nazwisko = 'Klient usunięty'" jest tekstem, który może wpisać człowiek, więc
  /// nie jest dowodem, że anonimizacja zaszła. Faza B używa jej jako bramki współbieżności
  /// (updateMany z where: { id, anonymized_at: null } — zwrócone count rozstrzyga wyścig w bazie,
  /// nie w JS; sprawdzenie findUnique + update byłoby tą samą klasą błędu co rezerwacja slotu w JS).
  /// Nullable bez wartości domyślnej i BEZ planu późniejszego NOT NULL: większość klientów nigdy
  /// nie będzie zanonimizowana, więc NULL to poprawny stan docelowy, a nie brak backfillu.
  anonymized_at DateTime? @db.Timestamptz(6)

  adresy            adresy[]
  leady             leady[]
  serwisy           serwisy[]
  usterki_incidents usterki_incidents[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model adresy {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  address_number String   @unique @default(dbgenerated("('A-'::text || lpad((nextval('addresses_address_number_seq'::regclass))::text, 6, '0'::text))"))
  klient_id      String?  @db.Uuid
  klient         klienci? @relation(fields: [klient_id], references: [id], onDelete: SetNull)
  ulica_miasto   String?
  // FLD-GEO-COORDS: współrzędne WGS84 (EPSG:4326) punktu docelowego wizyty.
  // Źródło: geokodowanie Google Places w kroku rezerwacji B2C. Nullable świadomie —
  // adresy sprzed tej migracji i adresy wpisane ręcznie w panelu B2B nie mają geokodowania.
  // Typ double precision, nie Decimal: te wartości służą do liczenia odległości
  // (Haversine / PostGIS), nigdy do porównań na równość. Patrz raport FLD-GEO-COORDS.
  latitude       Float?   @db.DoublePrecision
  longitude      Float?   @db.DoublePrecision
  created_at     DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  leady   leady[]
  serwisy serwisy[]

  /// PERF-B2B-AUDIT: klient_id — anonymizeClient() (RODO) wykonuje
  /// adresy.updateMany({ where: { klient_id } }) wewnątrz transakcji.
  @@index([klient_id])
}

model AuthorizedUser {
  id        String   @id @default(cuid())
  email     String   @unique
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model leady {
  id                        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  klient_id                 String?     @db.Uuid
  klient                    klienci?    @relation(fields: [klient_id], references: [id], onDelete: SetNull)
  adres_id                  String?     @db.Uuid
  adres                     adresy?     @relation(fields: [adres_id], references: [id], onDelete: SetNull)
  odpowiedzi_triage         Json?
  wybrana_konfiguracja      Json?
  estymowana_wycena         String?
  status                    LeadStatus? @default(NEW_LEAD)
  audytor_id                String?     @db.Uuid
  audytor                   audytorzy?  @relation(fields: [audytor_id], references: [id], onDelete: SetNull)
  data_rezerwacji           DateTime?   @db.Timestamptz(6)
  finalna_wycena_pln        Decimal?    @db.Decimal
  przewidywany_czas_montazu String?
  notatki_wewnetrzne        String?
  bucket_entered_at         DateTime?   @db.Timestamptz(6)
  // Z3: moment wystawienia wyceny. Zegar progu SLA.COLD_LEAD_REPRICE_DAYS (D3 — liczymy
  // od wyceny, nie od wejścia do bucketu). `updated_at` się nie nadaje: zmienia się przy każdej edycji.
  quoted_at                 DateTime?   @db.Timestamptz(6)
  // Z4: WYŁĄCZNIE wartość ze słownika LOST_REASONS (contracts/funnel.contract.mjs).
  // Techniczny znacznik automatu przeniesiony do auto_rejected_reason.
  lost_reason               String?
  // Z5: obowiązkowa notatka dla lost_reason = 'OTHER'. Walidacja obowiązkowości: Server Action.
  lost_reason_note          String?     @db.Text
  // Z4: znacznik automatycznego odrzucenia (np. 'AUTO_REJECT_14_DAYS'). Poza słownikiem
  // powodów utraty — nie zasila analityki LOST_REASONS (AC4.8).
  auto_rejected_reason      String?
  last_followup_date        DateTime?   @db.Timestamptz(6)
  // LOGISTICS-SHIPPING-EFFECTS Faza A (D2): jedyna reprezentacja „zegar SLA logistyczne
  // wstrzymany" po rollbacku (FNL-ROLLBACK, kryterium „SLA logistyczne zostaje wstrzymane").
  // Stempel ustawia się TYLKO gdy było null — powtórny rollback go nie przesuwa (AC-A5).
  // Wznowienie (powrót do null) należy do FNL-ROLLBACK-EXIT — poza zakresem tej fazy.
  logistics_sla_paused_at   DateTime?   @db.Timestamptz(6)

  // CRM-PROJECT-NUMBER (2026-09-10): czytelny numer projektu obok UUID, format L-000123.
  // NIE jest kluczem głównym i nie występuje w żadnym kluczu obcym — `id` (UUID) zostaje PK.
  // Nazwa angielska mimo polskiej nazwy tabeli: dług KK-NAMING-BASELINE jest ZAMROŻONY,
  // czyli obejmuje nazwy istniejące, a nie zwalnia z ADR-002 nowych kolumn.
  // Wartość nadaje baza z sekwencji leads_project_number_seq — Prisma jej NIE wylicza.
  project_number String @unique @default(dbgenerated("('L-'::text || lpad((nextval('leads_project_number_seq'::regclass))::text, 6, '0'::text))"))

  created_at DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  instalacje           instalacje[]
  logistyka_zamowienia logistyka_zamowienia[]
  bookings             Booking[]

  // ETAP 0 FIELD APP (2026-09-23): oferta, umowa i faktury wiszą na leadzie.
  // Kaskada zgodna z DELETE_POLICIES w contracts/rbac.contract.mjs (leads: CASCADE).
  quotes                Quote[]
  installationContracts InstallationContract[]
  invoices              Invoice[]

  @@index([status])
  @@index([created_at])
  /// PERF-B2B-AUDIT: indeksy na kolumnach FK. Postgres NIE tworzy ich automatycznie.
  /// Przy dzisiejszych danych (0 leadów) zysk jest ZEROWY — to ubezpieczenie na wzrost.
  /// audytor_id: getLeads() zawęża listę do własnych leadów audytora (scopeWhere =
  /// { audytor_id }) w findMany + count + groupBy; dodatkowo audytorzy.delete → SetNull.
  @@index([audytor_id])
  /// klient_id: getCustomers() liczy _count.leady per klient (agregacja po klient_id).
  @@index([klient_id])
  /// Wzorzec getLeads(): WHERE status = ? ORDER BY data_rezerwacji ASC, created_at DESC.
  /// Kolejność i kierunki odpowiadają dokładnie temu zapytaniu; prefiks (status,
  /// data_rezerwacji) obsługuje też getLogisticsLeads() (status IN (...) ORDER BY
  /// data_rezerwacji ASC). Istniejący @@index([status]) staje się redundantnym prefiksem —
  /// jego usunięcie byłoby zmianą odejmującą i wymaga osobnej decyzji, więc zostaje.
  @@index([status, data_rezerwacji(sort: Asc), created_at(sort: Desc)])
}

model multi_split_sets {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  outdoor_unit_id       String   @db.Uuid
  indoor_units_json     Json
  supported_rooms_count Int?
  set_price_netto       Decimal? @db.Decimal
  created_at            DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  is_bestseller         Boolean? @default(false)
}

model outdoor_units {
  id                           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  model_code                   String   @unique
  brand                        String
  type                         String
  max_indoor_units             Int?     @default(1)
  cooling_capacity_kw          Decimal? @db.Decimal
  heating_capacity_kw          Decimal? @db.Decimal
  max_total_indoor_capacity_kw Decimal? @db.Decimal
  dimensions                   String?
  price_netto                  Decimal? @db.Decimal
  image_url                    String?
  created_at                   DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

model single_split_sets {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  indoor_unit_id       String   @db.Uuid
  outdoor_unit_id      String   @db.Uuid
  seer                 Decimal? @db.Decimal
  scop                 Decimal? @db.Decimal
  energy_class_cooling String?
  energy_class_heating String?
  set_price_netto      Decimal? @db.Decimal
  created_at           DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  is_bestseller        Boolean? @default(false)

  @@unique([indoor_unit_id, outdoor_unit_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model soft_leady {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dane_kontaktowe String
  dane_cz_stkowe  Json?    @map("dane_cząstkowe")
  status          String?  @default("Nowy")
  created_at      DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  /// ── B2C-SOFT-LEAD-CONSENT (2026-09-24, migracja 20260926094000) ──
  /// Luka RODO potwierdzona przez Michała 2026-09-24: tabela zbierała numer telefonu ze strony
  /// lądowania (gałąź feat/b2c-triage) BEZ jakiejkolwiek zarejestrowanej podstawy — przed tą
  /// zmianą miała dokładnie pięć kolumn i ani jednej dotyczącej zgody.
  ///
  /// Wzorzec B2C-CONSENT-RODO i FLD-CONSENT-ACCEPT, bez odstępstw: NIGDY sama flaga logiczna,
  /// zawsze WSKAZANIE WERSJI kluczem obcym + moment. Flaga „zgodził się" nie odpowiada na
  /// pytanie „na co", a to jest jedyne pytanie, które pada przy kontroli.
  ///
  /// OBIE KOLUMNY SĄ NULLOWALNE I TO JEST ŚWIADOME, NIE NIEDOKOŃCZONE: tabela ma dane
  /// produkcyjne, a kolumna NOT NULL bez wartości domyślnej na istniejącej tabeli jest
  /// zabroniona. Zaostrzenie do NOT NULL wymaga najpierw rozstrzygnięcia, co zrobić
  /// z wierszami sprzed zmiany — backfill fałszywą zgodą jest ODRZUCONY wprost (byłby
  /// dowodem wytworzonym po fakcie). To jest pytanie do Work Ordera, nie do implementacji.
  /// Egzekwowanie „nie ma soft leada bez zgody" żyje do tego czasu w Server Action (Zod).
  consentVersionId String?   @map("consent_version_id") @db.Uuid
  consentGrantedAt DateTime? @map("consent_granted_at") @db.Timestamptz(6)

  /// RESTRICT, nie CASCADE i nie SET NULL — dokładnie jak przy employee_consents.version_id:
  /// wersji dokumentu, na którą ktoś się powołał, nie wolno usunąć, a zgoda wskazująca
  /// „coś, czego już nie ma" nie jest dowodem niczego.
  consentVersion LegalDocumentVersion? @relation(fields: [consentVersionId], references: [id], onDelete: Restrict)

  @@index([consentVersionId], map: "soft_leady_consent_version_id_idx")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model system_config {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  typ_konfiguracji String   @unique
  konfiguracja     Json
  created_at       DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

model zespoly_monterskie {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  crew_number        String  @unique @default(dbgenerated("('E-'::text || lpad((nextval('crews_crew_number_seq'::regclass))::text, 6, '0'::text))"))
  nazwa              String
  telefon_kontaktowy String?
  // @unique wymagane przez identyfikacje "czyj to rekord z sesji" (FLD-AVAILABILITY-SPLIT):
  // findUnique po e-mailu z sesji jest jedynym sposobem rozstrzygniecia, czy przekazane id
  // nalezy do wywolujacego. Pole zostaje NULLABLE - pracownik bez e-maila nie ma sciezki
  // samoobslugi i jest to swiadome ograniczenie, nie luka do naprawienia w tym WO.
  email              String? @unique
  aktywny            Boolean @default(true)

  // Nowe pola - Biznes
  nip                       String?
  koordynator_imie_nazwisko String?

  // Nowe pola - Kwalifikacje
  certyfikat_fgaz String?
  uprawnienia_sep Boolean @default(false)

  // Nowe pola - Logistyka
  kod_pocztowy_bazowy  String?
  promien_dzialania_km Int?
  liczba_brygad        Int     @default(1)
  posiada_wiertnice    Boolean @default(false)

  zdjecie_url      String?
  fgaz_valid_until DateTime? @db.Date
  sep_valid_until  DateTime? @db.Date

  // Nowe pola - Finanse
  iban String?

  // FLD-AVAILABILITY-SPLIT (D-A, 2026-08-21): status kadrowy ekipy — właściciel ADMINISTRATOR.
  // Symetrycznie do audytorzy.leave_status. Rozdzielenie musi objąć obie encje, mimo że dziś
  // żadna bramka autoryzacyjna nie czyta zespoly_monterskie.aktywny (R3 w WO) — brak konsumenta
  // po stronie ekip to luka do domknięcia, a nie powód, żeby zostawić ekipy bez tego pojęcia.
  // Pole `aktywny` powyżej zostaje pod tą nazwą: dług KK-NAMING-BASELINE jest zamrożony.
  leave_status LeaveStatus @default(ACTIVE)

  // FLD-AVAILABILITY-SPLIT: deklaracja dostępności ekipy — patrz komentarz przy audytorzy.
  availability_declaration AvailabilityDeclaration?

  // FLD-CONSENT-DOCS (2026-08-21): akceptacje dokumentów prawnych, symetrycznie do audytorów.
  // onDelete: Restrict — patrz komentarz przy audytorzy.consents.
  consents EmployeeConsent[]

  created_at DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  instalacje        instalacje[]
  serwisy           serwisy[]
  usterki_incidents usterki_incidents[]

  // FLD-CALENDAR-FOUNDATION (2026-09-10): trzy warstwy kalendarza.
  availability_rules AvailabilityRule[]
  absences           Absence[]
  bookings           Booking[]
}

model instalacje {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  installation_number String              @unique @default(dbgenerated("('I-'::text || lpad((nextval('installations_installation_number_seq'::regclass))::text, 6, '0'::text))"))
  lead_id             String              @db.Uuid
  lead                leady               @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  zespol_id           String?             @db.Uuid
  zespol              zespoly_monterskie? @relation(fields: [zespol_id], references: [id], onDelete: SetNull)
  data_planowana      DateTime?           @db.Timestamptz(6)
  data_zakonczenia    DateTime?           @db.Timestamptz(6)
  protokol_url        String?
  next_service_date   DateTime?           @db.Date
  status              InstallationStatus  @default(PLANNED)
  created_at          DateTime            @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  /// FNL-2PHASE kryt. 2 (D1, decyzja Michała 2026-09-16, migracja 20260916060000).
  /// Tryb montażu ustalony przez audytora na miejscu — wartość WIĄŻĄCA, deklaracja
  /// klienta z Triage jest tylko przesłanką. 'SINGLE_PHASE' albo 'TWO_PHASE';
  /// NULL = tryb NIEUSTALONY, nigdy „jednoetapowy" — guard installationIsTwoPhase
  /// przepuszcza wyłącznie jawne 'TWO_PHASE'. Pilnuje tego
  /// CONSTRAINT instalacje_installation_type_check (NULL przechodzi celowo).
  /// Nazwa pola snake_case wzorem project_number na `leady`: nowe pole na modelu
  /// z zamrożonego długu nazewniczego trzyma styl SWOJEGO modelu; sama kolumna jest
  /// po angielsku i snake_case, więc ADR-002 jest spełnione.
  installation_type String?

  serwisy             serwisy[]
  usterki_incidents   usterki_incidents[]
  installation_phases InstallationPhase[]

  // ETAP 0 FIELD APP (2026-09-23): dokumentacja zdjęciowa kasuje się z instalacją (Cascade),
  // umowa i faktura NIE — dokument rozliczeniowy przeżywa usunięcie rekordu montażu (SetNull),
  // bo jest dowodem księgowym, a nie częścią opisu instalacji.
  installationPhotos    InstallationPhoto[]
  installationContracts InstallationContract[]
  invoices              Invoice[]

  /// PERF-B2B-AUDIT: lead_id — zagnieżdżony select instalacje w getLeads() (WHERE lead_id
  /// IN (...)), findFirst({ where: { lead_id } }) w assignCrewToLead(), oraz kaskada
  /// onDelete: Cascade od leady. zespol_id — zespoly_monterskie.delete() → SetNull.
  @@index([lead_id])
  @@index([zespol_id])
}

model serwisy {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_number  String              @unique @default(dbgenerated("('S-'::text || lpad((nextval('services_service_number_seq'::regclass))::text, 6, '0'::text))"))
  klient_id       String?             @db.Uuid
  klient          klienci?            @relation(fields: [klient_id], references: [id], onDelete: SetNull)
  adres_id        String?             @db.Uuid
  adres           adresy?             @relation(fields: [adres_id], references: [id], onDelete: SetNull)
  instalacja_id   String?             @db.Uuid
  instalacja      instalacje?         @relation(fields: [instalacja_id], references: [id], onDelete: SetNull)
  zespol_id       String?             @db.Uuid
  zespol          zespoly_monterskie? @relation(fields: [zespol_id], references: [id], onDelete: SetNull)
  opis_usterki    String?
  data_zgloszenia DateTime            @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  data_realizacji DateTime?           @db.Timestamptz(6)
  status          ServiceStatus       @default(PLANNED)

  bookings Booking[]

  /// PERF-B2B-AUDIT: instalacja_id — instalacje.delete() → SetNull na serwisach.
  /// zespol_id — zespoly_monterskie.delete() → SetNull.
  /// Świadomie BEZ indeksu na klient_id i adres_id: dziś nie istnieje ścieżka usuwania
  /// klienta ani adresu (RODO anonimizuje, nie kasuje), a żadne zapytanie nie filtruje
  /// serwisów po tych kolumnach — getUpcomingServices() czyta całą tabelę.
  @@index([instalacja_id])
  @@index([zespol_id])
}

model logistyka_zamowienia {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipment_number       String         @unique @default(dbgenerated("('P-'::text || lpad((nextval('shipments_shipment_number_seq'::regclass))::text, 6, '0'::text))"))
  lead_id               String         @db.Uuid
  lead                  leady          @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  status_wysylki        ShippingStatus @default(PENDING)
  nr_listu_przewozowego String?
  firma_kurierska       String?
  tracking_id           String?
  data_wysylki          DateTime?      @db.Timestamptz(6)
  created_at            DateTime       @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  /// PERF-B2B-AUDIT: wzorzec „ostatnie zamówienie leada" — findFirst({ where: { lead_id },
  /// orderBy: { created_at: 'desc' } }) w markAsDelivered() oraz include z take: 1
  /// w getLogisticsLeads(). Kolejność kolumn i kierunek odpowiadają temu zapytaniu.
  @@index([lead_id, created_at(sort: Desc)])
}

model modele_3d {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nazwa          String
  plik_url       String
  kategoria      String?
  indoor_unit_id String?       @db.Uuid
  indoor_unit    indoor_units? @relation(fields: [indoor_unit_id], references: [id], onDelete: SetNull)
  created_at     DateTime      @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

enum LeadStatus {
  NEW_LEAD
  AWAITING_AUDIT
  AUDIT_COMPLETED
  AWAITING_CREW_ASSIGNMENT
