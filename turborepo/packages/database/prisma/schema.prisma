/// FLD-AVAILABILITY-SPLIT (D-A + R2, 2026-08-21): deklaracja dostępności pracownika terenowego.
/// WŁAŚCICIEL: PRACOWNIK. To jedyna tabela, na której role terenowe dostają `update` (wariant :own
/// w contracts/rbac.contract.mjs). Osobna tabela, a nie kolumna na audytorzy/zespoly_monterskie,
/// bo macierz RBAC i RLS operują na tabelach, nie na kolumnach: gdyby deklaracja była kolumną,
/// prawo do jej zapisu niosłoby ze sobą prawo do zapisu is_active i leave_status.
///
/// Jeden wiersz na pracownika, wskazywany dokładnie jednym z dwóch kluczy obcych (CHECK
/// availability_declarations_one_owner w migracji — Prisma nie wyraża CHECK-ów, więc żyje on
/// wyłącznie w SQL i NIE wolno go zgubić przy ewentualnym `prisma migrate diff`).
/// Brak wiersza znaczy „dostępny" (fail-open) — odwrotnie niż is_active, gdzie brak/blokada
/// znaczy odmowa (fail-closed). Migracja zakłada wiersze wszystkim istniejącym pracownikom (AC7).
///
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model AvailabilityDeclaration {
  // Nazwy pól wg ADR-002 (camelCase + @map), bo to model NOWY — nie dziedziczy zamrożonego
  // długu nazewniczego modeli polskich. Kolumny w bazie są snake_case tak samo jak wszędzie.
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  auditorId String?    @unique @map("auditor_id") @db.Uuid
  auditor   audytorzy? @relation(fields: [auditorId], references: [id], onDelete: Cascade)

  crewId String?             @unique @map("crew_id") @db.Uuid
  crew   zespoly_monterskie? @relation(fields: [crewId], references: [id], onDelete: Cascade)

  /// Deklaracja pracownika: „jestem dostępny" / „jestem teraz niedostępny".
  /// Boolean, a nie enum, świadomie: dwie wartości to pełny słownik tego pojęcia, a każda trzecia
  /// wartość, jaka przyszłaby komuś do głowy (URLOP, ZWOLNIENIE), należy do leave_status albo do
  /// absences. Typ domyka słownik tak samo jak enum (AC6).
  isAvailable Boolean @default(true) @map("is_available")

  createdAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)

  /// Moment ostatniej zmiany deklaracji. timestamptz, bo „niedostępny od teraz" bez strefy
  /// czasowej to ten sam błąd co porównywanie certyfikatów po dacie kalendarzowej.
  /// To znacznik techniczny — nie wyznacza granicy doby roboczej i nie wolno go do tego użyć.
  updatedAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("availability_declarations")
}

