/// FLD-CONSENT-DOCS (D-C, 2026-08-21): zamknięty słownik rodzajów dokumentu prawnego.
/// ENUM, a nie tabela słownikowa — świadomie. Dodanie rodzaju dokumentu nie jest wprowadzeniem
/// danych przez administratora, tylko zmianą kontraktu: faza 3 (Field App) musi wiedzieć, KTÓRYCH
/// rodzajów wymaga przed wpuszczeniem pracownika do zlecenia, a warunek „komplet zgód" potrzebuje
/// stabilnego identyfikatora. Gdyby rodzaje były wierszami, ten warunek zależałby od tego, co ktoś
/// wpisał w CRUD-zie. Tabela (id, kind, title) nie niosłaby przy tym ani jednego atrybutu ponad enum.
/// Cena zamierzona: rozszerzenie słownika wymaga migracji z ALTER TYPE ... ADD VALUE w osobnym pliku.
enum LegalDocumentKind {
  RODO_CONSENT
  EMPLOYEE_TERMS
}

/// FLD-CONSENT-DOCS (FLD-LEGAL-DOC-VERSION): wersjonowana treść zgód RODO i regulaminu pracowniczego.
/// WŁAŚCICIEL: ADMIN (rbac.contract.mjs: create/update/delete wyłącznie `admin`, AC7).
///
/// R3 (plik czy tekst) rozstrzygnięte na TEKST W BAZIE: obiekt w Storage jest mutowalny w miejscu,
/// więc nadpisanie pliku po cichu zmienia treść wersji już opublikowanej i łamie AC1 dokładnie tam,
/// gdzie AC1 ma znaczenie (dowód, co pracownik wtedy widział). W bazie niezmienność da się wymusić
/// wyzwalaczem, na buckecie nie da się wcale. Dodatkowo: bucketu na dokumenty prawne dziś nie ma
/// (są tylko awatarowe), a Field App i tak musi wyrenderować treść w oknie akceptacji.
///
/// Niezmienność wersji OPUBLIKOWANEJ jest własnością modelu, nie dyscypliną Server Action:
/// wyzwalacz legal_document_versions_freeze_published_trg (migracja 20260821130000) dopuszcza na
/// opublikowanym wierszu zmianę wyłącznie isCurrent. Nowa treść = NOWA WERSJA (AC1).
/// Prisma tego ograniczenia nie widzi i nie potrafi wyrazić — nie wolno go zgubić przy
/// ewentualnym `prisma migrate diff`.
///
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model LegalDocumentVersion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  documentKind LegalDocumentKind @map("document_kind")

  /// Jawny numer wersji, rosnący w obrębie rodzaju dokumentu — to jest „wersja" zapisywana przy
  /// akceptacji w sensie dokumentowym, a NIE data modyfikacji pliku (kryterium FLD-LEGAL-DOC-VERSION).
  /// Technicznym wskazaniem w rejestrze akceptacji pozostaje klucz obcy do id (AC3).
  versionNo Int @map("version_no")

  content String

  /// NULL = szkic. Szkic wolno edytować i usunąć; publikacja zamraża treść.
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  /// „Obowiązująca w tej chwili". Częściowy indeks unikalny w bazie
  /// (legal_document_versions_current_per_kind_key, WHERE is_current) dopuszcza DOKŁADNIE JEDNĄ
  /// taką wersję na rodzaj dokumentu — AC2 wymuszone przez bazę, nie przez sprawdzenie w kodzie,
  /// bo „sprawdź, czy jest inna obowiązująca, potem ustaw" przegrywa wyścig dwóch publikacji.
  /// Prisma nie potrafi wyrazić indeksu częściowego: ograniczenie żyje wyłącznie w SQL.
  isCurrent Boolean @default(false) @map("is_current")

  createdAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @updatedAt @map("updated_at") @db.Timestamptz(6)

  consents EmployeeConsent[]

  @@unique([documentKind, versionNo], map: "legal_document_versions_document_kind_version_no_key")
  @@map("legal_document_versions")
}

/// FLD-CONSENT-DOCS (FLD-CONSENT-ACCEPT): rejestr akceptacji — kto, którą wersję, kiedy.
///
/// APPEND-ONLY, profil audit_log: macierz RBAC nie daje `update` NIKOMU, łącznie z adminem,
/// a wyzwalacz employee_consents_append_only_trg odrzuca UPDATE także dla zapisu z pominięciem
/// Server Action (Prisma omija RLS — baza jest ostatnią warstwą, która cokolwiek gwarantuje).
/// Rejestr, który administrator może poprawić, nie jest dowodem niczego. To jest zarazem AC5
/// wymuszone strukturalnie: publikacja nowej wersji nie ma ścieżki, którą mogłaby unieważnić
/// istniejące akceptacje.
///
/// R1 — „pracownik" nie jest dziś encją: dwa nullowalne klucze obce + CHECK num_nonnulls(...) = 1,
/// ten sam wzorzec co AvailabilityDeclaration, bo `audytorzy` i `zespoly_monterskie` nie mają
/// wspólnego rekordu osoby. Konsekwencja wypowiedziana wprost: ta sama osoba występująca w obu
/// rolach akceptuje DWA RAZY. Odpowiedź „raz" wymaga encji osoby, której nie ma, a sklejenie po
/// adresie e-mail dawałoby dowód wskazujący na rekord, którego pracownik nigdy nie widział.
///
/// Egzekwowanie „brak zgód = brak zlecenia" NIE mieszka tutaj: decyzja D-D (2026-08-21) umieściła
/// je w Field App (faza 3). Ten model dowozi wyłącznie odpytywalność — „czy pracownik ma aktualną
/// akceptację" to złączenie po versionId do wersji z isCurrent = true.
///
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model EmployeeConsent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// AC9 / R2: onDelete Restrict, NIE Cascade i NIE SetNull. Usunięcie konta pracownika nie może
  /// skasować dowodu, że zgoda była udzielona w chwili wykonywania pracy, a wpis osierocony
  /// („ktoś zaakceptował") nie jest dowodem niczego. To wzmacnia w bazie politykę
  /// BLOCK_UNTIL_REASSIGNED, którą rbac.contract.mjs deklaruje dla `auditors` i `crews` — dotąd
  /// żyła wyłącznie w Server Action. Różnica wobec AvailabilityDeclaration (tam Cascade) jest
  /// zamierzona: deklaracja bez pracownika nie znaczy nic, akceptacja bez pracownika to skasowany dowód.
  auditorId String?    @map("auditor_id") @db.Uuid
  auditor   audytorzy? @relation(fields: [auditorId], references: [id], onDelete: Restrict)

  crewId String?             @map("crew_id") @db.Uuid
  crew   zespoly_monterskie? @relation(fields: [crewId], references: [id], onDelete: Restrict)

  /// AC3: wskazanie wersji kluczem obcym, nie tekstem ani numerem — wskazanie nieistniejącej wersji
  /// odrzuca baza. AC6: Restrict — wersji, do której odwołuje się jakakolwiek akceptacja, nie da się
  /// usunąć (SetNull byłby tu tak samo zły jak Cascade: AC3 wymaga, żeby wskazanie wersji dawało się
  /// rozstrzygnąć zawsze).
  /// Wyzwalacz employee_consents_version_must_be_current_trg dopuszcza przy INSERT wyłącznie wersję
  /// obowiązującą w chwili zapisu — to jest odpowiedź na przypadek brzegowy „publikacja nowej wersji
  /// w trakcie akceptowania starej": spóźniona akceptacja odbija się od bazy zamiast po cichu zapisać
  /// treść, której pracownik nie widział. Server Action MUSI więc przyjmować versionId jawnie
  /// z frontendu, a nie doklejać „najnowszą wersję" po stronie serwera.
  versionId String               @map("version_id") @db.Uuid
  version   LegalDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  /// timestamptz, nie date: „zaakceptował przed przypisaniem" liczy się na znacznikach, nie na
  /// datach kalendarzowych. Nigdy nie zmieniany (append-only).
  acceptedAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("accepted_at") @db.Timestamptz(6)

  /// Brak updatedAt — nie ma czego aktualizować w tabeli, której nikt nie aktualizuje.
  ///
  /// AC4: unikalność (pracownik, wersja) jako ograniczenie bazy, nie „sprawdź i wstaw" — dwa
  /// równoległe żądania akceptacji tej samej wersji dają dokładnie jeden wiersz. Dwa indeksy,
  /// bo właściciel siedzi w jednej z dwóch kolumn: w indeksie wielokolumnowym NULL-e są
  /// rozróżnialne, więc wiersze ekipowe nie kolidują z audytorskimi.
  @@unique([auditorId, versionId], map: "employee_consents_auditor_id_version_id_key")
  @@unique([crewId, versionId], map: "employee_consents_crew_id_version_id_key")
  @@index([versionId], map: "employee_consents_version_id_idx")
  @@map("employee_consents")
}

/// SEC-AUDIT-LOG-APPEND-ONLY / CRM-CLIENT-ANONYMIZE-RODO (WO CLIENT-ANONYMIZATION-RODO, Faza A).
///
/// Rejestr operacji wrażliwych wymaganych przez AUDIT_REQUIREMENTS.mustLog. Tabela powstaje
/// UNIWERSALNA (6 operacji × 13 zasobów), ale w tej fazie ma dokładnie jednego producenta:
/// anonimizację klienta (Faza B). Podpięcie pozostałych pięciu operacji jest świadomie poza zakresem.
///
/// APPEND-ONLY egzekwowane w TRZECH warstwach, bo żadna pojedyncza nie wystarcza:
///   1. MATRIX w rbac.contract.mjs (update: [], delete: [] — nikt, łącznie z adminem);
///   2. RLS: brak jakiejkolwiek polityki UPDATE/DELETE (odmowa domyślna, nie polityka zakazująca);
///   3. wyzwalacz audit_log_append_only_trg — JEDYNA warstwa działająca przeciw zapisowi Prismą,
///      która omija RLS (pułapka 1 w CLAUDE.md). Wzorzec skopiowany z employee_consents_append_only_trg.
///
/// Bez updated_at — nie ma czego aktualizować w tabeli, której nikt nie aktualizuje.
/// Retencja (AUDIT_REQUIREMENTS.retentionDays = 1825) NIE jest tu realizowana: purge stoi
/// w sprzeczności z wyzwalaczem i wymaga osobnej decyzji człowieka (osobne WO).
///
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// „Kto". TEXT, nie klucz obcy do AuthorizedUser — ta sama logika co onDelete: Restrict
  /// w EmployeeConsent, tylko mocniejsza: usunięcie konta nie może skasować ANI osierocić dowodu.
  /// Wartość pochodzi z auth.getUser().email, nie z getCurrentActorRole() (ta zwraca samą rolę).
  /// NOT NULL jest tu bramką fail-closed: zalogowany bez e-maila nie może wykonać operacji.
  actorEmail String @map("actor_email")

  /// Rola W CHWILI OPERACJI, utrwalona jako tekst. Rola konta może się później zmienić albo konto
  /// może zniknąć — wpis ma dokumentować stan z momentu zdarzenia, nie stan bieżący.
  actorRole String @map("actor_role")

  /// CHECK w bazie ogranicza do 7 wartości AUDIT_REQUIREMENTS.mustLog
  /// (6 pierwotnych + 'field_update', migracja 20260910103000).
  /// To oś OPERACJI AUDYTOWYCH, nie zdolności RBAC: anonimizacja klienta zapisuje się jako
  /// operation = 'anonymize', podczas gdy bramka pyta can(role, 'clients', 'delete').
  /// Te dwie osie się nie pokrywają i nie muszą.
  operation String

  /// CHECK w bazie ogranicza do 15 wartości: 13 pierwotnych + 'visit_duration_baskets'
  /// i 'system_config' (migracja 20260915120000, WO CAL-SCHEDULING-CONFIG-UI).
  /// UWAGA: to PODZBIÓR RESOURCES z rbac.contract.mjs, nie kopia — macierz zna dziś ~28 zasobów,
  /// a do rejestru dopuszczane są świadomie tylko te, które faktycznie coś logują.
  /// Nowy zasób w RESOURCES NIE trafia tu automatycznie; wymaga osobnej migracji.
  resource String

  /// „Na jakim rekordzie". TEXT, nie UUID i bez klucza obcego — tabela jest wspólna dla wszystkich
  /// zasobów, a AuthorizedUser.id to cuid(), nie uuid. Brak FK jest świadomy: FK do klienci byłby
  /// złamany przy każdej innej wartości resource, a RESTRICT zablokowałby kiedyś tę samą operację
  /// delete, którą ten rejestr ma dokumentować. Cena: wpis może wskazywać nieistniejący rekord.
  recordId String @map("record_id")

  /// AUDIT_REQUIREMENTS.requiresJustification: true. CHECK length(btrim(...)) >= 10 w bazie —
  /// pusty string i same białe znaki nie są uzasadnieniem, a walidacja Zod w Server Action
  /// jest wygodą dla użytkownika, nie gwarancją.
  justification String

  /// CHECK w bazie ogranicza do 5 wartości AUDIT_REQUIREMENTS.legalBases.
  legalBasis String @map("legal_basis")

  /// „Kiedy". UTC, spójnie z resztą schematu. Nigdy nie zmieniane (wyzwalacz).
  createdAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)

  /// „Co się działo z tym rekordem" — główne zapytanie rejestru (np. AC3: liczba wpisów
  /// dla record_id po N wywołaniach wynosi 1). Drugi indeks obsługuje przegląd chronologiczny
  /// i przyszłą retencję.
  @@index([resource, recordId], map: "audit_log_resource_record_id_idx")
  @@index([createdAt], map: "audit_log_created_at_idx")
  @@map("audit_log")
}

/// NTF-QUEUE-TABLE (WO LOGISTICS-SHIPPING-EFFECTS Faza B). Tabela istnieje w schemacie
/// PRZED jakimkolwiek producentem/konsumentem — `enqueueNotification()` i wpięcie w
/// akcje logistyki to Faza C tego samego WO, poza zakresem tej migracji.
/// `status` jako String + CHECK w bazie, nie enum Prisma — wzorem `AuditLog.operation`/
/// `.resource`/`.legalBasis` (audit_log), nie `LeadStatus`/`InstallationStatus`: słownik
/// PENDING|SENT|ERROR|DEAD_LETTER może rosnąć (por. uzasadnienie w migracji audit_log —
/// ALTER TYPE ... ADD VALUE nie działa w tej samej transakcji, CHECK aktualizuje się jednym
/// ALTER w transakcji).
model NotificationQueue {
  id String @id @default(cuid())

  /// ID z katalogu powiadomień (contracts/notifications.contract.mjs NOTIFICATIONS), np. "N5".
  notificationId String @map("notification_id")

  templateKey String @map("template_key")
  channel     String

  recipientType    String  @map("recipient_type")
  recipientAddress String? @map("recipient_address")

  payload Json

  /// CHECK notification_queue_status_check w bazie: PENDING|SENT|ERROR|DEAD_LETTER.
  status String @default("PENDING")

  attempts Int @default(0)

  lastError      String?   @map("last_error")
  nextAttemptAt  DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  deadLetteredAt DateTime? @map("dead_lettered_at") @db.Timestamptz(6)

  /// `requiresIdempotencyKey: true` (QUEUE_POLICY, ADR-007). Kolizja przy retry jest
  /// łapana (Prisma P2002) i traktowana jako sukces — nie jako błąd.
  idempotencyKey String @unique @map("idempotency_key")

  /// NTF-POLY: dokładnie jedno z czterech poniżej jest niepuste — wymuszone CHECK-iem
  /// notification_queue_one_owner w bazie, nie tylko w kodzie.
  leadId         String? @map("lead_id") @db.Uuid
  installationId String? @map("installation_id") @db.Uuid
  serviceId      String? @map("service_id") @db.Uuid
  incidentId     String? @map("incident_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  @@index([status], map: "notification_queue_status_idx")
  @@map("notification_queue")
}

/// ════════════════════════════════════════════════════════════════════════════════════
/// FLD-CALENDAR-FOUNDATION (2026-09-10) — fundament kalendarza, migracja
/// supabase/migrations/20260910100000_fld_calendar_foundation.sql.
///
/// CZEGO PRISMA TU NIE WIDZI, A BAZA MA — i czego NIE WOLNO zgubić przy ewentualnym
/// `prisma migrate diff`, dokładnie tak samo jak CHECK-ów przy availability_declarations:
///   1. Kolumna GENEROWANA `resource_id` = COALESCE(auditor_id, crew_id) w availability_rules,
///      absences i bookings. Prisma nie wyraża kolumn generowanych, a wpisanie jej jako
///      zwykłego pola zmusiłoby kod do jej podawania — czyli do rozjechania się z bazą.
///   1b. Kolumna GENEROWANA `subject_id` = COALESCE(lead_id, service_id, incident_id)
///      w bookings (migracja 20260910110000, FLD-BOOKING-ONE-ACTIVE-PER-SUBJECT) — ten sam
///      wzorzec i ten sam powód nieobecności w modelu co `resource_id`.
///   2. CHECK-i: *_one_owner (num_nonnulls = 1), zakresy czasu, słowniki wartości.
///   3. EXCLUDE USING gist `bookings_no_overlap_per_resource` — JĄDRO atomowości rezerwacji
///      (FNL-E3-E4, B2C-BOOKING-SLOT). Naruszenie: SQLSTATE 23P01, do zamiany na błąd
///      domenowy „slot zajęty", nie na 500.
///   4. Trigger `bookings_pool_matches_basket_trg` — audyt obsługuje audytor, reszta ekipa.
///   5. Unikalny indeks `availability_rules_resource_weekday_key` (jeden przedział na dzień).
///   6. CZĘŚCIOWY indeks unikalny `bookings_one_active_per_subject` na (subject_id)
///      WHERE status IN ('RESERVED','CONFIRMED') — jeden podmiot ma najwyżej JEDNĄ aktywną
///      rezerwację (FLD-BOOKING-ONE-ACTIVE-PER-SUBJECT). Naruszenie: SQLSTATE 23505, czyli
///      INNY kod niż 23P01 z bookings_no_overlap_per_resource i inna reakcja: przy 23P01
///      ponawia się na kolejnym kandydacie z puli, przy 23505 ponawianie nie ma sensu.
///      Indeks NIE jest odroczony — przełożenie terminu (CRM-BOOK-HISTORY) musi ustawić
///      stary wiersz na RELEASED przed wstawieniem nowego.
/// ════════════════════════════════════════════════════════════════════════════════════

/// CAL-VISIT-DURATION-BASKETS: słownik koszyków czasu trwania wizyty. Audytor WYBIERA
/// koszyk przy wycenie, a nie wpisuje godziny z palca; ten sam słownik zasila Triage jako
/// wstępne oszacowanie. Wartości są konfigurowalne w panelu B2B — literał czasu trwania
/// w kodzie jest naruszeniem. To NIE są progi SLA (te są niezmienne z definicji kontraktu),
/// tylko parametr operacyjny firmy, dlatego mieszkają w bazie, a nie w contracts/sla.
///
/// Dedykowana tabela, a nie JSONB w system_config, bo `bookings.visit_basket_id` musi być
/// kluczem obcym: koszyk dopasowywany stringiem rozjeżdża się przy pierwszej zmianie kodu.
///
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model VisitDurationBasket {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Stabilny identyfikator koszyka (AUDIT, SERVICE, INCIDENT, INSTALL_SMALL,
  /// INSTALL_STANDARD, INSTALL_PHASE_1, INSTALL_PHASE_2). Etykieta PL bywa zmieniana, kod nie.
  code String @unique

  /// Treść dla użytkownika, po polsku (ADR-002: polski wyłącznie w treściach).
  labelPl String @map("label_pl")

  /// MINUTY, nie godziny: 1,5 h nie jest liczbą całkowitą godzin, a liczba zmiennoprzecinkowa
  /// w harmonogramie to zaproszenie do błędu zaokrąglenia. Pół dnia = 240, cały dzień = 480.
  durationMinutes Int @map("duration_minutes")

  /// AUDITOR | CREW — dwie rozłączne pule. CHECK w bazie; trigger pilnuje zgodności
  /// z przypisaniem na rezerwacji.
  pool String

  /// Wycofanie koszyka ze słownika bez kasowania wiersza — rezerwacje historyczne muszą
  /// dalej wskazywać koszyk, którym zostały wycenione.
  isActive Boolean @default(true) @map("is_active")

  /// Kolejność na liście wyboru. Bez niej kolejność zależy od planu zapytania.
  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @updatedAt @map("updated_at") @db.Timestamptz(6)

  bookings Booking[]

  @@map("visit_duration_baskets")
}

/// FLD-AVAIL-WEEKLY-RULES: warstwa 1 dostępności (FIELD-APP-PLAN 6.2) — reguły cykliczne
/// „poniedziałki 8–16". WŁAŚCICIEL: PRACOWNIK, jak przy AvailabilityDeclaration i z tego
/// samego powodu: RBAC i RLS operują na tabelach, nie na kolumnach.
///
/// BRAK WIERSZY ZNACZY „domyślne okno pracy z system_config.scheduling_config", a nie
/// „niedostępny" — inaczej pracownik dodany po migracji nigdy nie trafiłby do puli
/// (ta sama pułapka, którą AvailabilityDeclaration rozwiązuje regułą „brak wiersza = dostępny").
///
/// JEDEN PRZEDZIAŁ NA DZIEŃ TYGODNIA (unikalny indeks w SQL). Wiele przedziałów obsłużyłoby
/// przerwę w środku dnia, ale zdjęcie unikalności później jest rozszerzeniem, a nałożenie jej
/// później wymagałoby kasowania danych — zaczynamy od wariantu, z którego da się wyjść.
///
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model AvailabilityRule {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  auditorId String?    @map("auditor_id") @db.Uuid
  auditor   audytorzy? @relation(fields: [auditorId], references: [id], onDelete: Cascade)

  crewId String?             @map("crew_id") @db.Uuid
  crew   zespoly_monterskie? @relation(fields: [crewId], references: [id], onDelete: Cascade)

  /// ISO-8601: 1 = poniedziałek … 7 = niedziela, zgodnie z EXTRACT(ISODOW). Zakres
  /// pilnowany CHECK-iem w bazie.
  weekday Int @db.SmallInt

  /// Czas LOKALNY (Europe/Warsaw), BEZ strefy — celowo. „8–16" ma znaczyć 8–16 również
  /// w dniu zmiany czasu (R6). Materializacja na konkretną datę i zamiana na UTC należy
  /// do silnika i musi jawnie wskazać strefę; dzień zmiany czasu ma 23 albo 25 godzin.
  startTime DateTime @map("start_time") @db.Time(6)
  endTime   DateTime @map("end_time") @db.Time(6)

  /// Wyłączenie reguły bez kasowania wiersza. KONIECZNE: `delete` ma wyłącznie admin
  /// (reguła globalna R13-rbac), więc bez tej flagi pracownik nie miałby jak zwolnić sobie
  /// środy inaczej niż prosząc administratora o skasowanie wiersza.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([auditorId])
  @@index([crewId])
  @@map("availability_rules")
}

/// CRM-ZESP-AC3 / ADR-012: warstwa 2 dostępności — datowane wyjątki (urlop, chorobowe,
/// awaria auta). Wpis nakładający się na slot usuwa go z widoku klienta; istniejące
/// rezerwacje w oknie absencji są RAPORTOWANE dyspozytorowi, nie kasowane po cichu.
///
/// ŚWIADOMIE BEZ ograniczenia wykluczającego: dwie nakładające się nieobecności tej samej
/// osoby (urlop, a w jego trakcie zwolnienie) to sytuacja prawdziwa, nie błąd danych.
///
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Absence {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  auditorId String?    @map("auditor_id") @db.Uuid
  auditor   audytorzy? @relation(fields: [auditorId], references: [id], onDelete: Cascade)

  crewId String?             @map("crew_id") @db.Uuid
  crew   zespoly_monterskie? @relation(fields: [crewId], references: [id], onDelete: Cascade)

  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)

  /// VACATION | SICK_LEAVE | VEHICLE_FAILURE | OTHER. String + CHECK, nie enum Prisma —
  /// ten sam wybór co przy AuditLog.operation i NotificationQueue.status: słownik powodów
  /// będzie rósł, a ALTER TYPE ... ADD VALUE nie działa w jednej transakcji z migracją.
  reason String

  /// Wolny tekst („awaria auta, warsztat do piątku"). Nie zastępuje reason.
  note String?

  /// „Kto wpisał" — adres e-mail, TEXT bez klucza obcego do AuthorizedUser. Ta sama decyzja
  /// co przy AuditLog.actorEmail: usunięcie konta nie może osierocić ani skasować śladu,
  /// kto zablokował komuś kalendarz. ADR-012 przewidywał FK; odstępstwo świadome.
  createdBy String? @map("created_by")

  createdAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)

  @@index([auditorId])
  @@index([crewId])
  @@map("absences")
}

/// FLD-BOOKING-ATOMIC-ASSIGN / ADR-012: warstwa 3 — konkretne rezerwacje i docelowo JEDYNE
/// źródło prawdy o terminach. `leady.data_rezerwacji` NIE zostało usunięte tą migracją:
/// przeniesienie danych i DROP COLUMN to osobna zmiana, po powstaniu konsumenta.
///
/// PRZYPISANIE NATYCHMIASTOWE (R3): klient widzi pulę, ale rezerwacja od razu wiąże
/// konkretną osobę. To nie jest szczegół UX — przy puli bezosobowej unikalność dotyczyłaby
/// POJEMNOŚCI puli, czyli czegoś, czego nie da się wyrazić ograniczeniem w bazie, a FNL-E3-E4
/// wymaga gwarancji w bazie, nie sprawdzenia w kodzie.
///
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Booking {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_number String @unique @default(dbgenerated("('B-'::text || lpad((nextval('bookings_booking_number_seq'::regclass))::text, 6, '0'::text))"))

  /// CZEGO DOTYCZY WIZYTA — dokładnie jedno z trzech (CHECK bookings_one_subject, wzorzec
  /// NTF-POLY). Montaż NIE MA własnej kolumny: rezerwacja montażu wisi na leadzie, a ADR-012
  /// wiąże etapy montażu z rezerwacją od drugiej strony (installation_phases.booking_id).
  /// Dodanie tu installation_id utworzyłoby drugą, konkurencyjną drogę tego samego powiązania.
  leadId String? @map("lead_id") @db.Uuid
  lead   leady?  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  serviceId String?  @map("service_id") @db.Uuid
  service   serwisy? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  incidentId String?            @map("incident_id") @db.Uuid
  incident   usterki_incidents? @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  /// KTO WYKONA — dokładnie jedno z dwóch (CHECK bookings_one_assignee).
  /// onDelete: Restrict, nie SetNull: rezerwacja bez wykonawcy jest obietnicą bez pokrycia.
  auditorId String?    @map("auditor_id") @db.Uuid
  auditor   audytorzy? @relation(fields: [auditorId], references: [id], onDelete: Restrict)

  crewId String?             @map("crew_id") @db.Uuid
  crew   zespoly_monterskie? @relation(fields: [crewId], references: [id], onDelete: Restrict)

  /// AUDITOR | CREW. Wartość wynika z tego, który klucz obcy jest niepusty — zostaje, bo
  /// przewiduje ją ADR-012, ale CHECK bookings_resource_kind_check wiąże ją z kolumnami
  /// źródłowymi, żeby redundancja nie mogła się rozjechać.
  resourceKind String @map("resource_kind")

  visitBasketId String              @map("visit_basket_id") @db.Uuid
  visitBasket   VisitDurationBasket @relation(fields: [visitBasketId], references: [id], onDelete: Restrict)

  /// UTC. `scheduledEnd` jest WYLICZONE z koszyka w chwili rezerwacji i UTRWALONE — nie liczy
  /// się go w locie, bo administrator może jutro zmienić czas trwania koszyka, a rezerwacja
  /// z wczoraj ma pozostać tym, co obiecano klientowi.
  scheduledStart DateTime @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd   DateTime @map("scheduled_end") @db.Timestamptz(6)

  /// RESERVED | CONFIRMED | RELEASED | COMPLETED (CHECK w bazie). RELEASED zwalnia slot bez
  /// kasowania śladu — wynik rollbacku T10–T13 oraz przełożenia terminu (CRM-BOOK-HISTORY).
  status String @default("RESERVED")

  /// CLIENT | DISPATCHER — kto zarezerwował. To NIE to samo co przypisanie wykonawcy.
  bookedBy String @default("CLIENT") @map("booked_by")

  /// AUTO | MANUAL — czy wykonawcę wskazał automat, czy nadpisał go dyspozytor (T01).
  /// Bez tej kolumny pytanie „dlaczego akurat ta ekipa" nie ma odpowiedzi po fakcie.
  assignmentMode String @default("AUTO") @map("assignment_mode")

  /// CRM-BOOK-HISTORY: przełożenie tworzy NOWY wiersz wskazujący poprzedni, a poprzedni
  /// dostaje status RELEASED. Historia jest łańcuchem, nie nadpisaniem.
  rescheduleOf   String?   @map("reschedule_of") @db.Uuid
  rescheduledTo  Booking?  @relation("BookingReschedule", fields: [rescheduleOf], references: [id], onDelete: SetNull)
  rescheduleFrom Booking[] @relation("BookingReschedule")

  createdAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Strona odwrotna installation_phases.booking_id. Kierunek klucza jest celowy:
  /// rezerwacja NIE MA kolumny installation_id (patrz komentarz przy leadId).
  ///
  /// LISTA, choć w bazie rezerwacja obsługuje DOKŁADNIE JEDEN etap. Relacja 1-1
  /// wymagałaby @unique na installation_phases.booking_id, a tamta unikalność jest
  /// CZĘŚCIOWA (WHERE booking_id IS NOT NULL) i Prisma nie potrafi jej wyrazić —
  /// zadeklarowanie pełnego @unique zakłamywałoby kształt indeksu w bazie i wywołało
  /// dryf przy introspekcji. Ten sam wzorzec, co bookings_one_active_per_subject:
  /// gwarancja mieszka w SQL, Prisma ją tylko opisuje (patrz nagłówek tego modelu).
  installationPhases InstallationPhase[]

  @@index([leadId])
  @@index([serviceId])
  @@index([incidentId])
  @@index([rescheduleOf])
  @@index([auditorId])
  @@index([crewId])
  @@map("bookings")
}

/// FNL-2PHASE / FNL-2PHASE-BOOKING — etapy montażu dwuetapowego
/// (migracja 20260916060000, WO FNL-2PHASE-BOOKING-MECHANICS).
///
/// Dokładnie DWA wiersze na instalację w trybie TWO_PHASE, ZERO w trybie SINGLE_PHASE
/// i ZERO przy trybie nieustalonym (installation_type IS NULL).
///
/// ZAKRES ZAWĘŻONY (D3, decyzja Michała 2026-09-16): wyłącznie mechanika rezerwacji
/// w panelu B2B. Nie ma tu i nie ma się pojawić pola na zdjęcie montażu, protokół
/// odbioru ani status płatności — Field App, upload zdjęć, generowanie PDF i płatności
/// są odłożone w całości i wymagają ADR-013. Brak tych pól jest decyzją, nie luką.
model InstallationPhase {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Powiązanie z leadem jest POŚREDNIE, przez instalacje.lead_id. Zdublowanie tu
  /// lead_id utworzyłoby drugą, konkurencyjną drogę do tej samej prawdy.
  installationId String     @map("installation_id") @db.Uuid
  installation   instalacje @relation(fields: [installationId], references: [id], onDelete: Cascade)

  /// 1 = przygotowanie instalacji przed wykończeniem, 2 = montaż jednostek po wykończeniu.
  /// CONSTRAINT installation_phases_phase_number_check ogranicza do (1, 2).
  /// Etapy NIE SĄ dwoma dniami pod rząd i NIE MA minimalnej przerwy między nimi
  /// (D2, decyzja Michała 2026-09-16) — żadnego progu w SLA, CHECK-u ani w kodzie.
  phaseNumber Int @map("phase_number") @db.SmallInt

  /// Osobna rezerwacja dla każdego etapu (FNL-2PHASE-BOOKING kryt. 1). NULL do czasu
  /// rezerwacji; dla etapu II NULL jest stanem NORMALNYM, nie brakiem danych.
  /// SET NULL, nie Cascade: skasowanie rezerwacji nie może skasować faktu istnienia
  /// etapu ani jego completedAt. Unikalność wymusza częściowy indeks
  /// installation_phases_booking_id_key (WHERE booking_id IS NOT NULL), którego
  /// Prisma nie potrafi wyrazić — dlatego NIE MA tu @unique: byłoby to kłamstwo
  /// o kształcie indeksu w bazie.
  bookingId String?  @map("booking_id") @db.Uuid
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  /// Moment zamknięcia etapu. NULL = etap otwarty i tym samym nośnik guardu
  /// phaseOneNotCompleted. Rezerwacja etapu II nie jest możliwa, dopóki etap 1
  /// ma tu NULL (FNL-2PHASE-BOOKING kryt. 3).
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Nośnik IDEMPOTENCJI tworzenia etapów: dwa równoległe wywołania dają dwa wiersze,
  /// nie cztery. Sprawdzenie w JS nie wystarcza (pułapka 4 z CLAUDE.md).
  @@unique([installationId, phaseNumber], map: "installation_phases_unique_phase")
  /// PERF-B2B-AUDIT: Postgres nie zakłada indeksu na kolumnie FK sam.
  @@index([installationId], map: "installation_phases_installation_id_idx")
  @@map("installation_phases")
}

/// Tabela wektorowej bazy wiedzy AI (pgvector)
model KnowledgeBase {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content     String
  metadata    Json?                  @default("{}")
  accessLevel String                 @map("access_level")
  embedding   Unsupported("vector")?
  createdAt   DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([accessLevel])
  @@index([embedding], map: "knowledge_base_embedding_hnsw_idx")
  @@map("knowledge_base")
}

