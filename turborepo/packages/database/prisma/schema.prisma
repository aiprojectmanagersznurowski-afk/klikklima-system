generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model indoor_units {
  id                           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  model_code                   String   @unique
  series_name                  String
  brand                        String
  is_single_compatible         Boolean? @default(false)
  is_multi_compatible          Boolean? @default(false)
  cooling_capacity_kw          Decimal? @db.Decimal
  heating_capacity_kw          Decimal? @db.Decimal
  power_consumption_cooling_kw Decimal? @db.Decimal
  power_consumption_heating_kw Decimal? @db.Decimal
  dimensions                   String?
  noise_level_min_db           Int?
  has_wifi                     Boolean? @default(false)
  has_presence_sensor          Boolean? @default(false)
  is_silent_mode               Boolean? @default(false)
  price_netto                  Decimal? @db.Decimal
  image_url                    String?
  marketing_description        String?
  created_at                   DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  color                        String?  @default("Biały")
  recommended_area_m2          Int?
  features                     Json?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model klienci {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imie_i_nazwisko String?
  email           String?
  telefon         String?
  created_at      DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model adresy {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  klient_id    String?  @db.Uuid
  ulica_miasto String?
  created_at   DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

model AuthorizedUser {
  id        String   @id @default(cuid())
  email     String   @unique
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model leady {
  id                        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  klient_id                 String?            @db.Uuid
  adres_id                  String?            @db.Uuid
  odpowiedzi_triage         Json?
  wybrana_konfiguracja      Json?
  estymowana_wycena         String?
  status                    LeadStatus?        @default(NEW_LEAD)
  audytor_id                String?            @db.Uuid
  data_rezerwacji           DateTime?          @db.Timestamptz(6)
  finalna_wycena_pln        Decimal?           @db.Decimal
  przewidywany_czas_montazu String?
  notatki_wewnetrzne        String?
  created_at                DateTime           @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at                DateTime           @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

model multi_split_sets {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  outdoor_unit_id       String   @db.Uuid
  indoor_units_json     Json
  supported_rooms_count Int?
  set_price_netto       Decimal? @db.Decimal
  created_at            DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  is_bestseller         Boolean? @default(false)
}

model outdoor_units {
  id                           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  model_code                   String   @unique
  brand                        String
  type                         String
  max_indoor_units             Int?     @default(1)
  cooling_capacity_kw          Decimal? @db.Decimal
  heating_capacity_kw          Decimal? @db.Decimal
  max_total_indoor_capacity_kw Decimal? @db.Decimal
  dimensions                   String?
  price_netto                  Decimal? @db.Decimal
  image_url                    String?
  created_at                   DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

model single_split_sets {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  indoor_unit_id       String   @db.Uuid
  outdoor_unit_id      String   @db.Uuid
  seer                 Decimal? @db.Decimal
  scop                 Decimal? @db.Decimal
  energy_class_cooling String?
  energy_class_heating String?
  set_price_netto      Decimal? @db.Decimal
  created_at           DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  is_bestseller        Boolean? @default(false)

  @@unique([indoor_unit_id, outdoor_unit_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model soft_leady {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dane_kontaktowe String
  dane_cz_stkowe  Json?    @map("dane_cząstkowe")
  status          String?  @default("Nowy")
  created_at      DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model system_config {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  typ_konfiguracji String   @unique
  konfiguracja     Json
  created_at       DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

enum LeadStatus {
  NEW_LEAD
  AUDITOR_ASSIGNED
  AUDIT_COMPLETED
  QUOTE_ACCEPTED
  PAID
  AWAITING_INSTALLATION
  HARDWARE_SHIPPED
  HARDWARE_DELIVERED
  INSTALLATION_IN_PROGRESS
  INSTALLATION_COMPLETED
}

enum ServiceStatus {
  PLANNED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  PAID
  PENDING
}

enum status_leada_enum {
  Nowy
  Weryfikacja
  Um_wiony_Audyt @map("Umówiony Audyt")
  Zrealizowane
  Soft_Lead      @map("Soft Lead")
  Utracony
}
