generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model indoor_units {
  id                           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  model_code                   String   @unique
  series_name                  String
  brand                        String
  is_single_compatible         Boolean? @default(false)
  is_multi_compatible          Boolean? @default(false)
  cooling_capacity_kw          Decimal? @db.Decimal
  heating_capacity_kw          Decimal? @db.Decimal
  power_consumption_cooling_kw Decimal? @db.Decimal
  power_consumption_heating_kw Decimal? @db.Decimal
  dimensions                   String?
  noise_level_min_db           Int?
  has_wifi                     Boolean? @default(false)
  has_presence_sensor          Boolean? @default(false)
  is_silent_mode               Boolean? @default(false)
  price_netto                  Decimal? @db.Decimal
  image_url                    String?
  marketing_description        String?
  created_at                   DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  color                        String?  @default("Biały")
  recommended_area_m2          Int?
  features                     Json?

  modele_3d modele_3d[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model klienci {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imie_i_nazwisko String?
  email           String?
  telefon         String?
  created_at      DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  adresy            adresy[]
  leady             leady[]
  serwisy           serwisy[]
  usterki_incidents usterki_incidents[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model adresy {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  klient_id    String?  @db.Uuid
  klient       klienci? @relation(fields: [klient_id], references: [id], onDelete: SetNull)
  ulica_miasto String?
  // FLD-GEO-COORDS: współrzędne WGS84 (EPSG:4326) punktu docelowego wizyty.
  // Źródło: geokodowanie Google Places w kroku rezerwacji B2C. Nullable świadomie —
  // adresy sprzed tej migracji i adresy wpisane ręcznie w panelu B2B nie mają geokodowania.
  // Typ double precision, nie Decimal: te wartości służą do liczenia odległości
  // (Haversine / PostGIS), nigdy do porównań na równość. Patrz raport FLD-GEO-COORDS.
  latitude     Float?   @db.DoublePrecision
  longitude    Float?   @db.DoublePrecision
  created_at   DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  leady   leady[]
  serwisy serwisy[]
}

model AuthorizedUser {
  id        String   @id @default(cuid())
  email     String   @unique
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model leady {
  id                        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  klient_id                 String?     @db.Uuid
  klient                    klienci?    @relation(fields: [klient_id], references: [id], onDelete: SetNull)
  adres_id                  String?     @db.Uuid
  adres                     adresy?     @relation(fields: [adres_id], references: [id], onDelete: SetNull)
  odpowiedzi_triage         Json?
  wybrana_konfiguracja      Json?
  estymowana_wycena         String?
  status                    LeadStatus? @default(NEW_LEAD)
  audytor_id                String?     @db.Uuid
  audytor                   audytorzy?  @relation(fields: [audytor_id], references: [id], onDelete: SetNull)
  data_rezerwacji           DateTime?   @db.Timestamptz(6)
  finalna_wycena_pln        Decimal?    @db.Decimal
  przewidywany_czas_montazu String?
  notatki_wewnetrzne        String?
  bucket_entered_at         DateTime?   @db.Timestamptz(6)
  // Z3: moment wystawienia wyceny. Zegar progu SLA.COLD_LEAD_REPRICE_DAYS (D3 — liczymy
  // od wyceny, nie od wejścia do bucketu). `updated_at` się nie nadaje: zmienia się przy każdej edycji.
  quoted_at                 DateTime?   @db.Timestamptz(6)
  // Z4: WYŁĄCZNIE wartość ze słownika LOST_REASONS (contracts/funnel.contract.mjs).
  // Techniczny znacznik automatu przeniesiony do auto_rejected_reason.
  lost_reason               String?
  // Z5: obowiązkowa notatka dla lost_reason = 'OTHER'. Walidacja obowiązkowości: Server Action.
  lost_reason_note          String?     @db.Text
  // Z4: znacznik automatycznego odrzucenia (np. 'AUTO_REJECT_14_DAYS'). Poza słownikiem
  // powodów utraty — nie zasila analityki LOST_REASONS (AC4.8).
  auto_rejected_reason      String?
  last_followup_date        DateTime?   @db.Timestamptz(6)
  created_at                DateTime    @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at                DateTime    @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  instalacje           instalacje[]
  logistyka_zamowienia logistyka_zamowienia[]

  @@index([status])
  @@index([created_at])
}

model multi_split_sets {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  outdoor_unit_id       String   @db.Uuid
  indoor_units_json     Json
  supported_rooms_count Int?
  set_price_netto       Decimal? @db.Decimal
  created_at            DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  is_bestseller         Boolean? @default(false)
}

model outdoor_units {
  id                           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  model_code                   String   @unique
  brand                        String
  type                         String
  max_indoor_units             Int?     @default(1)
  cooling_capacity_kw          Decimal? @db.Decimal
  heating_capacity_kw          Decimal? @db.Decimal
  max_total_indoor_capacity_kw Decimal? @db.Decimal
  dimensions                   String?
  price_netto                  Decimal? @db.Decimal
  image_url                    String?
  created_at                   DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

model single_split_sets {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  indoor_unit_id       String   @db.Uuid
  outdoor_unit_id      String   @db.Uuid
  seer                 Decimal? @db.Decimal
  scop                 Decimal? @db.Decimal
  energy_class_cooling String?
  energy_class_heating String?
  set_price_netto      Decimal? @db.Decimal
  created_at           DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  is_bestseller        Boolean? @default(false)

  @@unique([indoor_unit_id, outdoor_unit_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model soft_leady {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dane_kontaktowe String
  dane_cz_stkowe  Json?    @map("dane_cząstkowe")
  status          String?  @default("Nowy")
  created_at      DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model system_config {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  typ_konfiguracji String   @unique
  konfiguracja     Json
  created_at       DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

model zespoly_monterskie {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nazwa              String
  telefon_kontaktowy String?
  // @unique wymagane przez identyfikacje "czyj to rekord z sesji" (FLD-AVAILABILITY-SPLIT):
  // findUnique po e-mailu z sesji jest jedynym sposobem rozstrzygniecia, czy przekazane id
  // nalezy do wywolujacego. Pole zostaje NULLABLE - pracownik bez e-maila nie ma sciezki
  // samoobslugi i jest to swiadome ograniczenie, nie luka do naprawienia w tym WO.
  email              String?  @unique
  aktywny            Boolean  @default(true)
  
  // Nowe pola - Biznes
  nip                       String?
  koordynator_imie_nazwisko String?
  
  // Nowe pola - Kwalifikacje
  certyfikat_fgaz           String?
  uprawnienia_sep           Boolean @default(false)
  
  // Nowe pola - Logistyka
  kod_pocztowy_bazowy       String?
  promien_dzialania_km      Int?
  liczba_brygad             Int @default(1)
  posiada_wiertnice         Boolean @default(false)
  
  zdjecie_url               String?
  fgaz_valid_until          DateTime? @db.Date
  sep_valid_until           DateTime? @db.Date

  // Nowe pola - Finanse
  iban                      String?

  // FLD-AVAILABILITY-SPLIT (D-A, 2026-08-21): status kadrowy ekipy — właściciel ADMINISTRATOR.
  // Symetrycznie do audytorzy.leave_status. Rozdzielenie musi objąć obie encje, mimo że dziś
  // żadna bramka autoryzacyjna nie czyta zespoly_monterskie.aktywny (R3 w WO) — brak konsumenta
  // po stronie ekip to luka do domknięcia, a nie powód, żeby zostawić ekipy bez tego pojęcia.
  // Pole `aktywny` powyżej zostaje pod tą nazwą: dług KK-NAMING-BASELINE jest zamrożony.
  leave_status              LeaveStatus @default(ACTIVE)

  // FLD-AVAILABILITY-SPLIT: deklaracja dostępności ekipy — patrz komentarz przy audytorzy.
  availability_declaration  AvailabilityDeclaration?

  // FLD-CONSENT-DOCS (2026-08-21): akceptacje dokumentów prawnych, symetrycznie do audytorów.
  // onDelete: Restrict — patrz komentarz przy audytorzy.consents.
  consents                  EmployeeConsent[]

  created_at         DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  instalacje        instalacje[]
  serwisy           serwisy[]
  usterki_incidents usterki_incidents[]
}

model instalacje {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id          String              @db.Uuid
  lead             leady               @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  zespol_id        String?             @db.Uuid
  zespol           zespoly_monterskie? @relation(fields: [zespol_id], references: [id], onDelete: SetNull)
  data_planowana   DateTime?           @db.Timestamptz(6)
  data_zakonczenia DateTime?           @db.Timestamptz(6)
  protokol_url     String?
  next_service_date DateTime?           @db.Date
  status            InstallationStatus  @default(PLANNED)
  created_at        DateTime            @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  serwisy           serwisy[]
  usterki_incidents usterki_incidents[]
}

model serwisy {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  klient_id       String?             @db.Uuid
  klient          klienci?            @relation(fields: [klient_id], references: [id], onDelete: SetNull)
  adres_id        String?             @db.Uuid
  adres           adresy?             @relation(fields: [adres_id], references: [id], onDelete: SetNull)
  instalacja_id   String?             @db.Uuid
  instalacja      instalacje?         @relation(fields: [instalacja_id], references: [id], onDelete: SetNull)
  zespol_id       String?             @db.Uuid
  zespol          zespoly_monterskie? @relation(fields: [zespol_id], references: [id], onDelete: SetNull)
  opis_usterki    String?
  data_zgloszenia DateTime            @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  data_realizacji DateTime?           @db.Timestamptz(6)
  status          ServiceStatus       @default(PLANNED)
}

model logistyka_zamowienia {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id               String         @db.Uuid
  lead                  leady          @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  status_wysylki        ShippingStatus @default(PENDING)
  nr_listu_przewozowego String?
  firma_kurierska       String?
  tracking_id           String?
  data_wysylki          DateTime?      @db.Timestamptz(6)
  created_at            DateTime       @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

model modele_3d {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nazwa          String
  plik_url       String
  kategoria      String?
  indoor_unit_id String?       @db.Uuid
  indoor_unit    indoor_units? @relation(fields: [indoor_unit_id], references: [id], onDelete: SetNull)
  created_at     DateTime      @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

enum LeadStatus {
  NEW_LEAD
  AWAITING_AUDIT
  AUDIT_COMPLETED
  AWAITING_CREW_ASSIGNMENT
  HARDWARE_IN_WAREHOUSE
  HARDWARE_IN_TRANSIT
  AWAITING_INSTALLATION
  INSTALLATION_COMPLETED
  QUOTE_REJECTED
  ROLLBACK_RESCHEDULING
  // Z1 (WO CRM-SAFE-RECORD-ACTIONS): stan terminalny T16 „Archiwizuj trwale (Lost)".
  ARCHIVED_LOST
}

enum ServiceStatus {
  PLANNED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  PAID
  PENDING
}

enum status_leada_enum {
  Nowy
  Weryfikacja
  Um_wiony_Audyt @map("Umówiony Audyt")
  Zrealizowane
  Soft_Lead      @map("Soft Lead")
  Utracony
}

enum InstallationStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ShippingStatus {
  PENDING
  SHIPPED
  DELIVERED
}

/// FLD-AVAILABILITY-SPLIT (D-A, 2026-08-21): zamknięty słownik statusu kadrowego pracownika.
/// Właściciel: administrator. Wartości wg b2b_crm_specifications.md §5 i database_model.md:624
/// (Aktywny / Urlop / Zwolnienie). Prawdziwy typ enum w PostgreSQL, nie tekst — wartość spoza
/// słownika odrzuca baza, a nie dopiero walidacja aplikacyjna (AC6).
/// ACTIVE nie znaczy „konto aktywne" (to jest is_active) ani „pracownik dostępny"
/// (to jest availability_declarations.is_available) — znaczy wyłącznie „brak wpisanej nieobecności".
enum LeaveStatus {
  ACTIVE
  ON_LEAVE
  SICK_LEAVE
}

/// FLD-AVAILABILITY-SPLIT (D-A + R2, 2026-08-21): deklaracja dostępności pracownika terenowego.
/// WŁAŚCICIEL: PRACOWNIK. To jedyna tabela, na której role terenowe dostają `update` (wariant :own
/// w contracts/rbac.contract.mjs). Osobna tabela, a nie kolumna na audytorzy/zespoly_monterskie,
/// bo macierz RBAC i RLS operują na tabelach, nie na kolumnach: gdyby deklaracja była kolumną,
/// prawo do jej zapisu niosłoby ze sobą prawo do zapisu is_active i leave_status.
///
/// Jeden wiersz na pracownika, wskazywany dokładnie jednym z dwóch kluczy obcych (CHECK
/// availability_declarations_one_owner w migracji — Prisma nie wyraża CHECK-ów, więc żyje on
/// wyłącznie w SQL i NIE wolno go zgubić przy ewentualnym `prisma migrate diff`).
/// Brak wiersza znaczy „dostępny" (fail-open) — odwrotnie niż is_active, gdzie brak/blokada
/// znaczy odmowa (fail-closed). Migracja zakłada wiersze wszystkim istniejącym pracownikom (AC7).
///
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model AvailabilityDeclaration {
  // Nazwy pól wg ADR-002 (camelCase + @map), bo to model NOWY — nie dziedziczy zamrożonego
  // długu nazewniczego modeli polskich. Kolumny w bazie są snake_case tak samo jak wszędzie.
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  auditorId   String?             @unique @map("auditor_id") @db.Uuid
  auditor     audytorzy?          @relation(fields: [auditorId], references: [id], onDelete: Cascade)

  crewId      String?             @unique @map("crew_id") @db.Uuid
  crew        zespoly_monterskie? @relation(fields: [crewId], references: [id], onDelete: Cascade)

  /// Deklaracja pracownika: „jestem dostępny" / „jestem teraz niedostępny".
  /// Boolean, a nie enum, świadomie: dwie wartości to pełny słownik tego pojęcia, a każda trzecia
  /// wartość, jaka przyszłaby komuś do głowy (URLOP, ZWOLNIENIE), należy do leave_status albo do
  /// absences. Typ domyka słownik tak samo jak enum (AC6).
  isAvailable Boolean             @default(true) @map("is_available")

  createdAt   DateTime            @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)

  /// Moment ostatniej zmiany deklaracji. timestamptz, bo „niedostępny od teraz" bez strefy
  /// czasowej to ten sam błąd co porównywanie certyfikatów po dacie kalendarzowej.
  /// To znacznik techniczny — nie wyznacza granicy doby roboczej i nie wolno go do tego użyć.
  updatedAt   DateTime            @default(dbgenerated("timezone('utc'::text, now())")) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("availability_declarations")
}

model audytorzy {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imie_i_nazwisko String
  telefon         String?
  // @unique wymagane przez identyfikacje "czyj to rekord z sesji" (FLD-AVAILABILITY-SPLIT):
  // findUnique po e-mailu z sesji jest jedynym sposobem rozstrzygniecia, czy przekazane id
  // nalezy do wywolujacego. Pole zostaje NULLABLE - pracownik bez e-maila nie ma sciezki
  // samoobslugi i jest to swiadome ograniczenie, nie luka do naprawienia w tym WO.
  email           String?  @unique
  nazwa_firmy     String?
  nip             String?
  adres           String?
  zdjecie_url     String?
  certyfikat_fgaz String?
  
  // Nowe pola - Kwalifikacje
  doswiadczenie_hvac_lata Int?
  uprawnienia_sep         Boolean @default(false)
  preferowane_marki       String[]
  
  // Nowe pola - Logistyka
  kod_pocztowy_bazowy     String?
  max_promien_dojazdu_km  Int?
  
  fgaz_valid_until        DateTime? @db.Date
  sep_valid_until         DateTime? @db.Date

  // Nowe pola - Finanse
  iban                    String?

  // Z2 (D1): blokada konta audytora. false = brak dostępu do Field App i brak w puli
  // wyboru przy przypisywaniu. Odwracalna (AC1.7). Nazwa angielska wg ADR-002,
  // mimo polskiej nazwy tabeli — dług KK-NAMING-BASELINE jest zamrożony.
  is_active               Boolean  @default(true)

  // FLD-AVAILABILITY-SPLIT (D-A, 2026-08-21): status kadrowy — właściciel ADMINISTRATOR.
  // To NIE jest deklaracja pracownika: urlop i zwolnienie wpisuje administrator, a pracownik
  // nie ma do tej kolumny prawa zapisu (auditors.update zostaje ['admin'] w rbac.contract.mjs).
  // Świadomie NIE nazywa się availability_status: „dostępność" należy do pracownika i mieszka
  // w osobnej tabeli. Docelowo (ADR-012, faza 4) urlop przenosi się do datowanej tabeli absences;
  // ta kolumna jest nośnikiem zgrubnym do tego czasu.
  leave_status            LeaveStatus @default(ACTIVE)

  // FLD-AVAILABILITY-SPLIT: deklaracja dostępności pracownika mieszka w OSOBNEJ tabeli
  // (availability_declarations), a nie w kolumnie tutaj. To jedyny układ, w którym prawo zapisu
  // do własnej dostępności nie niesie ze sobą prawa zapisu do is_active — macierz RBAC operuje
  // na zasobach (tabelach), nie na kolumnach, a RLS też działa na poziomie tabeli.
  availability_declaration AvailabilityDeclaration?

  // FLD-CONSENT-DOCS (2026-08-21): akceptacje dokumentów prawnych. Relacja na onDelete: Restrict
  // (patrz EmployeeConsent.auditor) — usunięcie audytora z historią akceptacji jest ODRZUCANE przez
  // bazę, bo skasowałoby dowód, że zgody były udzielone w chwili wykonywania pracy (R2 w WO).
  // To zaostrza dotychczasowy stan: BLOCK_UNTIL_REASSIGNED z rbac.contract.mjs blokował usunięcie
  // tylko przy wiszących leadach i tylko w Server Action. Ścieżki „usuń mimo wszystko" nie ma
  // celowo — analogiczna do SEC-RODO-DELETE anonimizacja pracownika jest luką zarejestrowaną
  // w FLD-CONSENT-ACCEPT, nie czymś, co ta migracja dopisuje po cichu.
  consents        EmployeeConsent[]

  // Z6: relacja poniżej zostaje na onDelete: SetNull — świadomie, NIE zmieniać na Restrict.
  // Blokada usunięcia audytora dotyczy WYŁĄCZNIE rekordów w statusach AWAITING_AUDIT /
  // AUDIT_COMPLETED i żyje w Server Action; baza nie rozróżnia statusu, więc Restrict
  // zablokowałby także rekordy zimne i zarchiwizowane, wbrew D1.

  created_at      DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  leady           leady[]
}

model usterki_incidents {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numer_zgloszenia String?             @unique
  klient_id        String?             @db.Uuid
  klient           klienci?            @relation(fields: [klient_id], references: [id], onDelete: SetNull)
  instalacja_id    String?             @db.Uuid
  instalacja       instalacje?         @relation(fields: [instalacja_id], references: [id], onDelete: SetNull)
  zespol_id        String?             @db.Uuid
  zespol           zespoly_monterskie? @relation(fields: [zespol_id], references: [id], onDelete: SetNull)
  priorytet        String?             @default("NISKI")
  status           String?             @default("NOWE")
  opis_usterki     String?
  zdjecia_url      Json?
  created_at       DateTime            @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

model cennik_uslug {
