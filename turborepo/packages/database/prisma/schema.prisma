  // długu nazewniczego modeli polskich. Kolumny w bazie są snake_case tak samo jak wszędzie.
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  auditorId String?    @unique @map("auditor_id") @db.Uuid
  auditor   audytorzy? @relation(fields: [auditorId], references: [id], onDelete: Cascade)

  crewId String?             @unique @map("crew_id") @db.Uuid
  crew   zespoly_monterskie? @relation(fields: [crewId], references: [id], onDelete: Cascade)

  /// Deklaracja pracownika: „jestem dostępny" / „jestem teraz niedostępny".
  /// Boolean, a nie enum, świadomie: dwie wartości to pełny słownik tego pojęcia, a każda trzecia
  /// wartość, jaka przyszłaby komuś do głowy (URLOP, ZWOLNIENIE), należy do leave_status albo do
  /// absences. Typ domyka słownik tak samo jak enum (AC6).
  isAvailable Boolean @default(true) @map("is_available")

  createdAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)

  /// Moment ostatniej zmiany deklaracji. timestamptz, bo „niedostępny od teraz" bez strefy
  /// czasowej to ten sam błąd co porównywanie certyfikatów po dacie kalendarzowej.
  /// To znacznik techniczny — nie wyznacza granicy doby roboczej i nie wolno go do tego użyć.
  updatedAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("availability_declarations")
}

